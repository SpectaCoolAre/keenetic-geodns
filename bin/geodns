#!/bin/sh
# geodns — обход геоблока через DNS на роутере Keenetic (Entware).
#
# Та же логика, что в умном DNS модуля nfqws2-android-ext на телефоне, — тем
# же кодом: проверка серверов — geodns-helper -geoscan -doh (nfqws2-helper модуля;
# только DoH: роутер ходит к серверам через https-dns-proxy), выбор серверов —
# geo-pool.awk, geo-routes.awk, geo-rel.awk из модуля. Поэтому дома телефон и
# роутер выбирают одинаково, а модуль за роутером видит, что роутер обходит
# группу сам, и оставляет её ему (один адрес выхода на всех устройствах).
#
#   устройства -> dnsmasq (порт 53 роутера)
#     домены списка геоблока -> https-dns-proxy 127.0.0.1:<порт сервера> -> сервер обхода
#     группа сайтов (groups.list: Google, OpenAI, Anthropic, xAI) — целиком
#                               через один сервер
#     домен, который не обходит никто, и всё остальное -> DNS провайдера, а с
#                               DEFAULT_DOH — https-dns-proxy 127.0.0.1:DEFAULT_PORT
#                               -> честный DoH (провайдер не подменит ответ)
#
#   geodns start|stop|restart   — обычно через /opt/etc/init.d/S55geodns
#   geodns status               — что работает, какие серверы, последние записи журнала
#   geodns scan                 — полная проверка серверов сейчас (и применить)
#   geodns check                — частая проверка основных сервисов сейчас (и применить)
#   geodns routes               — маршруты: «домен сервер» (как в модуле — для сравнения)
#   geodns test <домен>         — куда идёт домен, ответ роутера и провайдера
#   geodns update               — скачать свежий список геоблока (itdoginfo)
#   geodns log                  — журнал целиком

R=${GEODNS_ROOT:-}                 # тесты подменяют корень
D=$R/opt/etc/geodns
CONF=$D/geodns.conf
LIST=$D/geoblock.list
OWN=$D/own.list
GROUPS=$D/groups.list              # = defaults/dns-geo-groups.list модуля
PREFER=$D/prefer.list              # = defaults/dns-geo-prefer.list модуля
SERVERS_LIST=$D/servers.list       # = defaults/dns-geo-servers.list модуля
OFF=$D/off.list                    # серверы, отключённые вручную
GEO_CONF=$D/dnsmasq-geo.conf
UP_CONF=$D/upstream.conf
ST=$R/opt/var/lib/geodns           # итоги проверок — переживают перезагрузку
DOWN=$ST/down.list                 # на паузе: прокси здесь не открывается (см. proxy_check)
RUN=$R/opt/var/run/geodns
LOG=$R/opt/var/log/geodns.log
HELPER=${HELPER:-$R/opt/bin/geodns-helper}
LIST_URL="https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Categories/geoblock.lst"

PROVIDER_DNS=""; BOOTSTRAP="77.88.8.8,1.1.1.1"; PORT=5053; ALIVE_EVERY=60
DEFAULT_DOH=""; DEFAULT_PORT=5099
# как в модуле (lib/dns.sh): полная проверка — раз в 4 часа, частая — раз в
# полчаса, основные сервисы — всегда в частой
SCAN_EVERY=14400; HOT_EVERY=1800
HOT_BASE="chatgpt.com claude.ai gemini.google.com geminiweb-pa.clients6.google.com signaler-pa.clients6.google.com apis.google.com waa-pa.clients6.google.com gamea.clashofclans.com accounts.supercell.com spotify.com"
REF="https://common.dot.dns.yandex.net/dns-query,77.88.8.8:53"
SCAN_VER=4
# пока проверки не было (или ни один сервер не ответил) — весь список сюда, а
# не к провайдеру: иначе дома до первой удачной проверки геоблок везде.
# Роутер ходит только по DoH, а zapret.moe — сервер только с DoH, в домашней
# сети (09.11) обходил 254 домена списка; Comss с ноября не обходит ИИ-сервисы
FALLBACK="dns.zapret.moe"
[ -f "$CONF" ] && . "$CONF"
# Go ищет корневые сертификаты и по SSL_CERT_FILE: в Entware они здесь
[ -f "$R/opt/etc/ssl/certs/ca-certificates.crt" ] && export SSL_CERT_FILE="$R/opt/etc/ssl/certs/ca-certificates.crt"
DOH_URL="${DOH_URL:-https://%s/dns-query}"   # тесты подменяют
# Адрес DoH сервера: «имя/путь» (api.magicdns.ru/sync) — по своему пути
doh_url() { case "$1" in */*) echo "https://$1" ;; *) echo "$DOH_URL" | sed "s|%s|$1|" ;; esac; }
mkdir -p "$RUN" "$ST" "${LOG%/*}"
SCAN=$ST/scan.tsv

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"
  # журнал не растёт бесконечно: внутренняя память роутера маленькая
  if [ "$(wc -l < "$LOG")" -gt 600 ]; then tail -n 400 "$LOG" > "$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"; fi
}

# ---------------------------------------------------------------- dnsmasq
# Служба dnsmasq из Entware (обычно S56dnsmasq). Её может и не быть (пакет
# без службы) — тогда dnsmasq запускается напрямую с нашим конфигом
dnsmasq_init() { ls "$R"/opt/etc/init.d/S*dnsmasq* 2>/dev/null | head -n 1; }
dnsmasq_bin() { [ -x "$R/opt/sbin/dnsmasq" ] && echo "$R/opt/sbin/dnsmasq" || command -v dnsmasq; }
dnsmasq_restart() {
  local svc bin out
  bin=$(dnsmasq_bin)
  [ -n "$bin" ] || { log "dnsmasq не установлен (opkg install dnsmasq-full)"; return 1; }
  out=$("$bin" --test -C "$R/opt/etc/dnsmasq.conf" 2>&1)
  case "$out" in *OK*) ;; *) log "ошибка в конфиге dnsmasq: $out"; return 1 ;; esac
  svc=$(dnsmasq_init)
  if [ -n "$svc" ]; then out=$("$svc" restart 2>&1)
  else killall dnsmasq 2>/dev/null; sleep 1; out=$("$bin" -C "$R/opt/etc/dnsmasq.conf" 2>&1); fi
  sleep 1
  if pidof dnsmasq >/dev/null; then log "dnsmasq запущен (${svc:-$bin})"; return 0; fi
  # служба Entware пишет только «failed» — причину скажет сам dnsmasq
  [ -n "$svc" ] && out=$("$bin" -C "$R/opt/etc/dnsmasq.conf" 2>&1) && sleep 1 && pidof dnsmasq >/dev/null &&
    { log "dnsmasq запущен ($bin)"; return 0; }
  log "dnsmasq не запустился (${svc:-$bin}): ${out:-без сообщений}"
  # порт 53 у встроенного DNS Keenetic: в CLI роутера не включён opkg dns-override
  if netstat -lnup 2>/dev/null | grep ':53 ' | grep -qv dnsmasq; then
    log "порт 53 занят: $(netstat -lnup 2>/dev/null | grep ':53 ' | grep -v dnsmasq | awk '{ print $NF }' | sort -u | tr '\n' ' ')— в CLI роутера выполните: opkg dns-override, затем system configuration save"
  fi
  return 1
}

# IPv4-адреса из ответа busybox nslookup (оба формата вывода)
ips() { # <имя> <сервер>
  nslookup "$1" "$2" 2>/dev/null | awk '
    /^Name:/ { n = 1; next }
    n { while (match($0, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) { print substr($0, RSTART, RLENGTH); $0 = substr($0, RSTART + RLENGTH) } }' |
    sort -u
}

# DNS провайдера: из настройки, иначе из Keenetic (RCI), иначе Яндекс
provider() {
  local p
  p=$(echo "$PROVIDER_DNS" | tr ',' ' ' | awk '{ print $1 }')
  if [ -z "$p" ]; then
    p=$(curl -s --max-time 5 http://127.0.0.1:79/rci/show/ip/name-server 2>/dev/null |
      grep -o '"address": *"[0-9.]*"' | grep -o '[0-9]*\.[0-9]*\.[0-9]*\.[0-9]*' |
      grep -v -E '^(127\.|0\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -n 1)
  fi
  echo "${p:-77.88.8.8}"
}
# DNS провайдера не нашёлся ни в настройке, ни у Keenetic — вместо него Яндекс
provider_missing() {
  [ -z "$PROVIDER_DNS" ] && [ -z "$(curl -s --max-time 5 http://127.0.0.1:79/rci/show/ip/name-server 2>/dev/null |
    grep -o '"address": *"[0-9.]*"' | grep -o '[0-9]*\.[0-9]*\.[0-9]*\.[0-9]*' |
    grep -v -E '^(127\.|0\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)')" ]
}
providers_all() {
  if [ -n "$PROVIDER_DNS" ]; then echo "$PROVIDER_DNS" | tr ',' ' '; else provider; fi
}
dns_alive() { [ -n "$(ips ya.ru 127.0.0.1)" ]; }
net_alive() { [ -n "$(ips ya.ru "$(provider)")" ]; }

# DoH-запрос прямо к серверу (для DEFAULT_DOH и geodns test): запрос — байтами
# через printf, ответ — разбор od. -> адреса A
doh() { # <сервер> <имя>
  local f="$RUN/q.$$" url h ip
  awk -v n="$2" 'BEGIN {
    for (i = 1; i < 128; i++) ord[sprintf("%c", i)] = i
    s = "\\022\\064\\001\\000\\000\\001\\000\\000\\000\\000\\000\\000"
    k = split(n, L, ".")
    for (i = 1; i <= k; i++) { s = s sprintf("\\%03o", length(L[i])); for (j = 1; j <= length(L[i]); j++) s = s sprintf("\\%03o", ord[substr(L[i], j, 1)]) }
    printf "%s\\000\\000\\001\\000\\001", s }' > "$f.fmt"
  printf "$(cat "$f.fmt")" > "$f.q"
  url=$(doh_url "$1")
  # имя сервера — через BOOTSTRAP, а не через dnsmasq: тот сам ходит через этот
  # DoH, и при сбое его прокси проверка «не отвечала» и у живого сервера
  h=${1%%/*}; ip=$(ips "$h" "${BOOTSTRAP%%,*}" | head -n 1)
  curl -s --max-time 6 -H 'content-type: application/dns-message' -H 'accept: application/dns-message' \
    ${ip:+--resolve "$h:443:$ip"} --data-binary @"$f.q" "$url" -o "$f.r" 2>/dev/null
  { od -An -tu1 -v "$f.r" 2>/dev/null || hexdump -v -e '1/1 "%u "' "$f.r" 2>/dev/null; } | awk '
    { for (i = 1; i <= NF; i++) b[++N] = $i }
    function skip(p) { while (p <= N) { if (b[p] == 0) return p + 1; if (b[p] >= 192) return p + 2; p += b[p] + 1 } return p }
    END {
      if (N < 12) exit
      an = b[7] * 256 + b[8]; p = skip(13) + 4
      for (i = 0; i < an && p <= N; i++) {
        p = skip(p); ty = b[p] * 256 + b[p + 1]; rl = b[p + 8] * 256 + b[p + 9]; p += 10
        if (ty == 1 && rl == 4) print b[p] "." b[p + 1] "." b[p + 2] "." b[p + 3]
        p += rl
      }
    }' | sort -u
  rm -f "$f.fmt" "$f.q" "$f.r"
}

# ---------------------------------------------------------------- проверка серверов
# Домены списка: geoblock.list и свои (own.list), без комментариев
names() {
  { cat "$LIST" 2>/dev/null; cat "$OWN" 2>/dev/null; } | tr -d '\r' | tr 'A-Z' 'a-z' |
    sed 's/[[:space:]]*#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' |
    grep -E '^[a-z0-9.-]+\.[a-z0-9-]+$' | sort -u
}
servers() { sed 's/[[:space:]]*#.*//' "$SERVERS_LIST" 2>/dev/null | awk 'NF && !/^\[/ { print $1 }' | tr '\n' ',' | sed 's/,$//'; }
scan_time() { sed -n '1s/^#time=\([0-9]*\).*/\1/p' "$1" 2>/dev/null; }
# Проверка — как dns_geo_scan модуля, тем же helper. full — весь
# список раз в 4 часа; hot — основные сервисы раз в полчаса и по факту
# (сертификат сайта по адресу прокси, «unusual traffic»)
scan() { # full|hot
  local out boot n
  [ -x "$HELPER" ] || { log "нет $HELPER — проверка невозможна (переустановите пакет: opkg install --force-reinstall keenetic-geodns)"; return 1; }
  "$HELPER" -h 2>&1 | grep -q geoscan || { log "$HELPER не запускается на этом роутере — сборка не под его процессор: переустановите пакет keenetic-geodns"; : > "$RUN/scan.failed"; return 1; }
  net_alive || { sleep 5; net_alive; } || { sleep 10; net_alive; } || { log "нет интернета (провайдер не отвечает) — проверку пропускаю"; return 1; }
  mkdir "$RUN/scan.lock" 2>/dev/null || { log "проверка уже идёт"; return 1; }
  boot="$(provider):53"
  if [ "$1" = hot ]; then
    echo "$HOT_BASE" | tr ' ' '\n' > "$RUN/samples"; out=$SCAN.hot.tmp
    { echo "#time=$(date +%s) boot=$boot v=$SCAN_VER"
      "$HELPER" -geoscan "$(servers)" -samples "@$RUN/samples" -boot "$boot" -ref "$REF" -wait 20s -max 3 \
        -groups "$GROUPS" -asncache "$ST/asn.cache" -shared "$SCAN" -verify -doh 2>"$RUN/helper.err"
    } > "$out"
  else
    names > "$RUN/samples"; out=$SCAN.tmp
    { echo "#time=$(date +%s) boot=$boot v=$SCAN_VER"
      "$HELPER" -geoscan "$(servers)" -samples "@$RUN/samples" -boot "$boot" -ref "$REF" -wait 40s -max 3 \
        -groups "$GROUPS" -asncache "$ST/asn.cache" -doh \
        -verifyhosts "$(echo "$HOT_BASE" | tr ' ' '\n' | grep -v '^game' | tr '\n' ' ')" 2>"$RUN/helper.err"
    } > "$out"
  fi
  rmdir "$RUN/scan.lock" 2>/dev/null
  # ни один сервер не ответил — прежний итог остаётся
  if ! grep -q '	ok	' "$out"; then
    # почему: ошибки серверов (первые три) или сообщение самого helper
    log "проверка ($1): ни один сервер не ответил — остаётся прежний итог; повтор через 10 минут"
    awk -F'\t' '!/^[#=+!?]/ && $2 == "fail" && n++ < 3 { print "  " $1 ": " $8 }' "$out" | while IFS= read -r n; do log "$n"; done
    [ -s "$RUN/helper.err" ] && log "  geodns-helper: $(tail -n 3 "$RUN/helper.err" | tr '\n' ' ')"
    grep -q -v '^#' "$out" || log "  geodns-helper ничего не вывел"
    rm -f "$out"; : > "$RUN/scan.failed"; return 1
  fi
  # полная: ответили меньше половины прошлых (было не меньше 4) — сбой сети
  # на время проверки (12.11: 2 из 13, и все группы ушли на semqka); третий
  # такой итог подряд — уже правда, принимается
  if [ "$1" = full ]; then
    local nn po nf
    nn=$(grep -c '	ok	' "$out"); po=$(grep -c '	ok	' "$SCAN" 2>/dev/null); po=${po:-0}
    nf=$(cat "$RUN/scan.short" 2>/dev/null); nf=${nf:-0}
    if [ "$po" -ge 4 ] && [ $((nn * 2)) -lt "$po" ] && [ "$nf" -lt 2 ]; then
      echo $((nf + 1)) > "$RUN/scan.short"
      log "проверка (full): ответили $nn серверов, в прошлый раз $po — похоже на сбой сети, остаётся прежний итог; повтор через 10 минут"
      rm -f "$out"; : > "$RUN/scan.failed"; return 1
    fi
    rm -f "$RUN/scan.short"
  fi
  rm -f "$RUN/scan.failed"
  if [ "$1" = hot ]; then mv -f "$out" "$SCAN.hot"; rel_update "$SCAN.hot"
  else mv -f "$out" "$SCAN"; rm -f "$SCAN.hot"; rel_update "$SCAN"; fi
  n=$(grep -c '	ok	' "$SCAN" 2>/dev/null)
  [ "$1" = hot ] || log "полная проверка: ответили ${n:-0} из $(grep -c -v '^[#=+!?]' "$SCAN")"
  # ответившие с оговоркой: не на все домены (DoH ограничивает частоту)
  awk -F'\t' '!/^[#=+!?]/ && $2 == "ok" && $8 != "" { print $1 ": " $8 }' "${out%.tmp}" | while IFS= read -r n; do log "  $n"; done
  return 0
}
scan_due() { # <файл> <секунд> — пора проверять?
  local t
  # неудачная проверка — повтор не раньше чем через 10 минут
  [ -n "$(find "$RUN/scan.failed" -mmin -10 2>/dev/null)" ] && return 1
  t=$(scan_time "$1")
  [ -n "$t" ] || return 0
  head -n 1 "$1" | grep -q " v=$SCAN_VER\$" || return 0
  # список серверов сменился (обновление пакета) — прежняя проверка не о нём
  [ "$1" = "$SCAN" ] && [ "$(scanned "$1")" != "$(servers | tr ',' '\n' | sort | tr '\n' ' ')" ] && return 0
  [ $(( $(date +%s) - t )) -ge "$2" ]
}
# Частая — не раньше HOT_EVERY и после частой, и после полной: полная удаляет
# файл частой, и та шла через минуту — серверы, только что получившие сотни
# запросов, ей не отвечали
hot_due() {
  local t h
  [ -n "$(find "$RUN/scan.failed" -mmin -10 2>/dev/null)" ] && return 1
  t=$(scan_time "$SCAN"); [ -n "$t" ] || return 1
  h=$(scan_time "$SCAN.hot"); [ -n "$h" ] && [ "$h" -gt "$t" ] && t=$h
  [ $(( $(date +%s) - t )) -ge "$HOT_EVERY" ]
}
# Серверы, которые проверка спрашивала (строки итога), — по алфавиту
scanned() { awk -F'\t' '!/^[#=+!?]/ && NF > 1 { print $1 }' "$1" 2>/dev/null | sort | tr '\n' ' '; }

# ---------------------------------------------------------------- выбор — общий код модуля
rel_update() { awk -F'\t' -v gf="$GROUPS" -v rf="$SCAN.rel" -f "$D/geo-rel.awk" "$1"; }
# Не брать: отключённые вручную и на паузе; на паузе все ответившие — только
# отключённые вручную (лучше пробовать, чем никуда)
# Закреплённые за группой серверы («=сервер» в prefer.list)
fixed() { sed 's/#.*//' "$PREFER" 2>/dev/null | tr ' \t' '\n\n' | sed -n 's/^=//p'; }
off_eff() {
  local e="$RUN/off.eff"
  # закреплённый на паузу не встаёт: проба HTTPS через его прокси ничего не
  # говорит об играх (NullsProxy вставал на паузу, и Supercell уходил к другим)
  { cat "$OFF" 2>/dev/null; cut -f1 "$DOWN" 2>/dev/null | grep -v -x -F "$(fixed)"; } | awk 'NF && !s[$0]++' > "$e.$$"
  if [ -s "$DOWN" ] && ! awk -F'\t' -v of="$e.$$" 'BEGIN { while ((getline l < of) > 0) o[l] = 1 }
      !/^[#=+!?]/ && $2 == "ok" && $4 > 0 && !($1 in o) { x = 1 } END { exit !x }' "$SCAN" 2>/dev/null; then
    cat "$OFF" 2>/dev/null > "$e.$$"
  fi
  mv -f "$e.$$" "$e"; echo "$e"
}
pool() { [ -s "$SCAN" ] || return 0; awk -F'\t' -v of="$(off_eff)" -v pf="$SCAN.pin" -f "$D/geo-pool.awk" "$SCAN" | sort -n | head -n 3; }
pick() { pool | head -n 1 | cut -f2; }
pick_or_fallback() { local p; p=$(pick); echo "${p:-$FALLBACK}"; }
routes() { # [save] -> «домен<TAB>сервер<TAB>протокол» | «домен<TAB>-»
  local h="" fresh=0 ft
  [ -s "$SCAN" ] || return 0
  [ -s "$SCAN.hot" ] && [ "$SCAN.hot" -nt "$SCAN" ] && h=$SCAN.hot
  ft=$(scan_time "${h:-$SCAN}")
  [ -n "$ft" ] && [ $(( $(date +%s) - ft )) -lt $(( HOT_EVERY * 2 )) ] && fresh=1
  names > "$RUN/names"
  awk -F'\t' -v prf="$PREFER" -v of="$(off_eff)" -v pf="$SCAN.pin" -v gpf="$ST/groups.pin" -v rf="$SCAN.rel" \
    -v fresh="$fresh" -v keepfail=1 -v base="$HOT_BASE" -v gf="$GROUPS" -v gl="$RUN/names" -v hf="$h" -v save="$1" -v pool="$(pick)" \
    -f "$D/geo-routes.awk" "$SCAN" $h
}
pin_save() {
  local p; p=$(pick)
  { [ -n "$p" ] && echo "* $p"; grep -v '^[*] ' "$SCAN.pin" 2>/dev/null; } > "$SCAN.pin.tmp"
  mv -f "$SCAN.pin.tmp" "$SCAN.pin"
  routes save > /dev/null
}

# ---------------------------------------------------------------- применение
# Серверы — порты: сервер пула на $PORT, остальные — $PORT+1, +2… (мимо DEFAULT_PORT)
ports() { # -> «сервер порт»
  { pick_or_fallback; awk -F'\t' '$2 != "-" { print $2 }' "$RUN/routes" 2>/dev/null; } |
    awk -v p="$PORT" -v dp="$DEFAULT_PORT" 'NF && !s[$1]++ { if (p + n == dp) n++; print $1, p + n++ }'
}
port_of() { awk -v h="$1" '$1 == h { print $2; exit }' "$RUN/ports" 2>/dev/null; }
build() {
  local p pp
  : > "$UP_CONF.tmp"
  if default_on; then echo "server=127.0.0.1#$DEFAULT_PORT" >> "$UP_CONF.tmp"
  else for p in $(providers_all); do echo "server=$p" >> "$UP_CONF.tmp"; done; fi
  mv -f "$UP_CONF.tmp" "$UP_CONF"
  routes > "$RUN/routes"
  ports > "$RUN/ports"
  pp=$(port_of "$(pick_or_fallback)")
  # домен — к серверу своего маршрута; «-» (никто не обходит) — к провайдеру,
  # без строки; без маршрута — к серверу пула
  names | awk -v rf="$RUN/routes" -v pf="$RUN/ports" -v pp="$pp" '
    BEGIN { while ((getline l < pf) > 0) { split(l, a, " "); P[a[1]] = a[2] }
      while ((getline l < rf) > 0) { split(l, a, "\t"); T[a[1]] = a[2] } }
    { d = $0
      if (d in T) { if (T[d] != "-" && (T[d] in P)) print "server=/" d "/127.0.0.1#" P[T[d]]; next }
      if (pp != "") print "server=/" d "/127.0.0.1#" pp }' > "$GEO_CONF.tmp"
  mv -f "$GEO_CONF.tmp" "$GEO_CONF"
}

proxy_alive() { netstat -lnu 2>/dev/null | grep -q "127\.0\.0\.1:$1 "; }
proxy_start() { # <сервер> <порт>
  local out
  out=$(https-dns-proxy -a 127.0.0.1 -p "$2" -r "$(case "$1" in */*) echo "https://$1" ;; *) echo "https://$1/dns-query" ;; esac)" -b "$BOOTSTRAP" -d 2>&1 | grep -v -i -E 'root|^-+$')
  sleep 1
  proxy_alive "$2" || log "прокси $1 (порт $2) не запустился: ${out:-без сообщений}"
}
proxies_start() {
  local h p
  killall https-dns-proxy 2>/dev/null; sleep 1
  while read -r h p; do proxy_start "$h" "$p"; done < "$RUN/ports"
  default_start
}
proxies_keep() {   # упавшие — поднять
  local h p
  while read -r h p; do proxy_alive "$p" || { log "прокси $h (порт $p) упал — перезапуск"; proxy_start "$h" "$p"; }; done < "$RUN/ports"
}
# Новый выбор — в работу: что сменилось, видно в журнале
apply() {
  local old
  old=$(cat "$GEO_CONF" "$RUN/ports" 2>/dev/null | md5sum)
  cp -f "$RUN/routes" "$RUN/routes.before" 2>/dev/null
  pin_save; build
  [ "$old" = "$(cat "$GEO_CONF" "$RUN/ports" 2>/dev/null | md5sum)" ] && return 0
  log "серверы обхода: $(summary)$(routes_diff)"
  proxies_start; dnsmasq_restart
}
summary() { # «пул — X; по доменам: X — 120, Y — 30, к провайдеру — 40»
  awk -F'\t' -v p="$(pick)" -v fb="$FALLBACK" '$2 == "-" { net++; next } { n[$2]++ }
    END { x = p; if (x == "") x = fb " (запасной: проверки ещё не было)"
      out = "пул — " x "; по доменам: "; sep = ""
      for (h in n) { out = out sep h " — " n[h]; sep = ", " }
      if (net) out = out sep "к провайдеру — " net
      print out }' "$RUN/routes"
}
routes_diff() { # группы и основные сервисы, у которых сменился сервер
  [ -s "$RUN/routes.before" ] || return 0
  awk -F'\t' -v base="$HOT_BASE" 'BEGIN { n = split(base, b, " "); for (i = 1; i <= n; i++) B[b[i]] = 1 }
    FNR == NR { o[$1] = $2; next }
    ($1 in B) && ($1 in o) && o[$1] != $2 { sep = "; сменились: "; if (k++) sep = ", "; out = out sep $1 " " o[$1] " → " $2 }
    END { printf "%s", out }' \
    "$RUN/routes.before" "$RUN/routes"
}

# ---------------------------------------------------------------- DoH по умолчанию
# Всё, что не из списков, — не обычным DNS (порт 53), а через https-dns-proxy
# к честному DoH. Провайдер вроде Дом.ру перехватывает обычный DNS (даже к
# 8.8.8.8 и 77.88.8.8) и на заблокированные сайты отдаёт адрес своего сервера.
# DoH он не подменит. Не отвечает DoH — временно DNS провайдера (метка
# $RUN/default.down): без DNS дома не открылось бы ничего
default_on() { [ -n "$DEFAULT_DOH" ] && [ ! -f "$RUN/default.down" ]; }
default_start() {
  [ -n "$DEFAULT_DOH" ] || return 0
  proxy_alive "$DEFAULT_PORT" || proxy_start "$DEFAULT_DOH" "$DEFAULT_PORT"
}
default_ok() { [ -n "$(doh "$DEFAULT_DOH" ya.ru | grep -v '[^0-9.]')" ]; }
# Переключение — только после трёх проверок подряд (три минуты) в одну сторону:
# DoH, отвечающий через раз, иначе дёргал перезапуск dnsmasq раз в минуту, и на
# эти секунды DNS пропадал у всей сети (11.11)
default_keep() {
  local n
  [ -n "$DEFAULT_DOH" ] || return 0
  default_start
  n=$(cat "$RUN/default.streak" 2>/dev/null); n=${n:-0}
  if [ ! -f "$RUN/default.down" ]; then
    if ! default_ok && net_alive; then n=$((n + 1)); else n=0; fi
    if [ "$n" -ge 3 ]; then
      n=0; : > "$RUN/default.down"
      log "DoH по умолчанию ($DEFAULT_DOH) не отвечает три минуты — $(provider_text)"
      build; dnsmasq_restart
    fi
  else
    if default_ok; then n=$((n + 1)); else n=0; fi
    if [ "$n" -ge 3 ]; then
      n=0; rm -f "$RUN/default.down"
      log "DoH по умолчанию ($DEFAULT_DOH) снова отвечает — всё, что не из списков, снова через него"
      build; dnsmasq_restart
    fi
  fi
  echo "$n" > "$RUN/default.streak"
}
default_text() {
  if default_on; then echo "DoH $DEFAULT_DOH"
  elif [ -n "$DEFAULT_DOH" ]; then echo "$(provider_text) (DoH $DEFAULT_DOH не отвечает)"
  else provider_text; fi
}
provider_text() {
  if provider_missing; then echo "запасной DNS $(provider) — DNS провайдера нет ни в настройках роутера, ни в PROVIDER_DNS"
  else echo "DNS провайдера $(providers_all | tr '\n' ' ' | sed 's/ $//')"; fi
}

# ---------------------------------------------------------------- сторож
# ---------------------------------------------------------------- пауза серверов
# ТСПУ в разных сетях и районах блокирует разные адреса прокси серверов обхода
# (11.11: прокси wlrus перестал открываться, и с ним — ChatGPT, Claude и игры
# Supercell, закреплённые за ним). Сервер, чей прокси не открывается, встаёт
# на паузу (down.list), сайты уходят на другие; проверка снова — через 30 мин,
# 1 ч, дальше раз в 2 ч; открылся — сервер возвращается.
# Прокси сервера — адрес, который он отдаёт чаще всего; домен — тот, для
# которого он его отдаёт (основные сервисы — первыми). Игровые серверы
# (gamea.clashofclans.com, game.*) — не по HTTPS: проба HTTPS к ним «не
# открывалась» и у рабочего прокси, и NullsProxy (только для Supercell)
# вставал на паузу — игры уходили на другой сервер. Сервер, у которого есть
# только такие домены, не проверяется
# Кроме одного домена на сервер — каждый основной сервис (claude.ai,
# chatgpt.com…) по маршруту: у сервера прокси разные, и проверка по одному
# сайту не замечала закрытый прокси для другого (модуль, МТС, 12.11)
proxy_targets() { # -> «сервер прокси домен»; закреплённые не проверяются
  awk -F'\t' -v base="$HOT_BASE" -v fx=" $(fixed | tr '\n' ' ') " \
    -v rt="$(awk -F'\t' '$2 != "" && $2 != "-" { printf " %s=%s", $1, $2 }' "$RUN/routes" 2>/dev/null)" '
    BEGIN { nb = split(base, b, " "); for (i = 1; i <= nb; i++) B[b[i]] = 1 }
    /^\+/ { h = substr($1, 2); if (!(h in px) || $3 + 0 > pn[h]) { px[h] = $2; pn[h] = $3 + 0 }; next }
    /^=game[a-z0-9]*\./ { next }
    /^=/ { d = substr($1, 2); n = split($2, sv, ",")
      for (i = 1; i <= n; i++) { h = sv[i]; if (!(h in dm) || ((d in B) && !(dm[h] in B))) dm[h] = d } }
    END { for (h in px) if ((h in dm) && !index(fx, " " h " ")) print h, px[h], dm[h]
      nr = split(rt, rr, " "); for (i = 1; i <= nr; i++) { j = index(rr[i], "="); R[substr(rr[i], 1, j - 1)] = substr(rr[i], j + 1) }
      for (i = 1; i <= nb; i++) { d = b[i]; if (d ~ /^game[a-z0-9]*\./ || !(d in R)) continue; h = R[d]
        if ((h in px) && dm[h] != d && !index(fx, " " h " ")) print h, px[h], d } }' "$SCAN" 2>/dev/null
}
# Открывается ли сайт через прокси: TLS и хоть какой-то ответ HTTP
proxy_open() { # <прокси> <домен>
  [ "$(curl -s -o /dev/null -m 8 -w '%{http_code}' --resolve "$2:443:$1" "https://$2/" 2>/dev/null)" != 000 ]
}
# Проверить прокси: all — всех серверов (после полной проверки), use — серверов
# в работе и тех, кто на паузе со сроком (после частой), due — только на паузе
# со сроком (сторож, раз в минуту — обычно ничего). Пауза сменилась — маршруты заново
proxy_check() { # all|use|due
  local now act s ip d ch a
  [ -s "$SCAN" ] || return 0
  now=$(date +%s)
  act=" $(pick) $(cut -f2 "$RUN/routes" 2>/dev/null | sort -u | tr '\n' ' ') "
  proxy_targets | while read -r s ip d; do
    nx=$(awk -F'\t' -v s="$s" '$1 == s { print $4; exit }' "$DOWN" 2>/dev/null)
    case "$1" in
      all) ;;
      use) if [ -n "$nx" ]; then [ "$nx" -le "$now" ] || continue; else case "$act" in *" $s "*) ;; *) continue ;; esac; fi ;;
      *) [ -n "$nx" ] && [ "$nx" -le "$now" ] || continue ;;
    esac
    # адрес — тот, что сервер даёт для этого домена сейчас: самый частый мог
    # быть прокси других сайтов, и проба «не открывалась» у рабочего сервера
    a=$("$HELPER" -ask "$s" -samples "$d" -boot "$(provider):53" -doh -wait 6s 2>/dev/null | head -n 1 | cut -f2 | cut -d, -f1)
    [ -n "$a" ] && ip=$a
    if proxy_open "$ip" "$d"; then echo "$s	$ip	up"; else echo "$s	$ip	down"; fi
  done > "$RUN/pcheck"
  # полная: на паузе остаются только те, кого есть чем проверить
  if [ "$1" = all ] && [ -s "$DOWN" ]; then
    proxy_targets | awk 'NR == FNR { t[$1] = 1; next } ($1 in t)' - "$DOWN" > "$DOWN.t"; mv -f "$DOWN.t" "$DOWN"
  fi
  [ -s "$RUN/pcheck" ] || return 0
  ch=$(cat "$DOWN" 2>/dev/null | awk -F'\t' -v res="$RUN/pcheck" -v now="$now" -v out="$DOWN.new" '
    BEGIN { while ((getline l < res) > 0) { split(l, a, "\t")
        # несколько прокси сервера: не открылся хоть один — пауза
        if (!(a[1] in v) || a[3] == "down") { v[a[1]] = a[3]; ip[a[1]] = a[2] } } }
    NF >= 5 { old[$1] = $0; n[$1] = $5; since[$1] = $3 }
    END {
      for (s in v) {
        if (v[s] == "down") {
          k = (s in n) ? n[s] + 1 : 1; d = 1800
          for (i = 1; i < k && d < 7200; i++) d *= 2
          if (d > 7200) d = 7200
          print s "\t" ip[s] "\t" ((s in since) ? since[s] : now) "\t" (now + d) "\t" k > out
          if (!(s in old)) print "down " s " " ip[s]
        } else if (s in old) print "up " s
      }
      for (s in old) if (!(s in v)) print old[s] > out
      close(out) }')
  if [ -s "$DOWN.new" ]; then mv -f "$DOWN.new" "$DOWN"; else rm -f "$DOWN.new" "$DOWN"; fi
  [ -n "$ch" ] || return 0
  printf '%s\n' "$ch" | while read -r w s ip; do
    if [ "$w" = down ]; then log "на паузе: $s — его прокси $ip отсюда не открывается, сайты уходят на другие серверы"
    else log "снова в работе: $s — прокси открывается"; fi
  done
  apply
}
# Одна проверка или перестройка за раз: команда (geodns scan) и сторож делили
# порты и файлы маршрутов, и прокси запускался на порту, который уже отдан
# другому серверу. Сторож занятое пропускает, команда ждёт (до 10 минут)
work_lock() { # [wait]
  local i=0 o
  while ! mkdir "$RUN/work.lock" 2>/dev/null; do
    o=$(cat "$RUN/work.lock/pid" 2>/dev/null)
    if [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null; then rm -rf "$RUN/work.lock"; continue; fi
    [ "$1" = wait ] || return 1
    i=$((i + 1)); [ "$i" -ge 600 ] && return 1
    sleep 1
  done
  echo $$ > "$RUN/work.lock/pid"
}
work_unlock() { rm -rf "$RUN/work.lock"; }
watch() {
  echo $$ > "$RUN/watch.pid"
  sleep 20   # после загрузки — дать WAN подняться
  while :; do
    default_keep
    if ! pidof dnsmasq >/dev/null || ! dns_alive; then
      if net_alive || ! pidof dnsmasq >/dev/null; then log "dnsmasq не отвечает — перезапуск"; dnsmasq_restart; fi
    fi
    # упавшие прокси — под той же блокировкой: во время перестройки порты
    # уже новые, а прокси ещё старые, и «упавшим» казался рабочий
    if work_lock; then
      proxies_keep
      if scan_due "$SCAN" "$SCAN_EVERY"; then scan full && apply && proxy_check all
      elif hot_due; then scan hot && apply && proxy_check use
      else proxy_check due
      fi
      work_unlock
    fi
    sleep "$ALIVE_EVERY"
  done
}
watch_pid() { local p; p=$(cat "$RUN/watch.pid" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# ---------------------------------------------------------------- команды
start() {
  rmdir "$RUN/scan.lock" 2>/dev/null
  rm -f "$RUN/default.down"
  build; proxies_start; dnsmasq_restart
  [ -n "$(watch_pid)" ] || { "$0" watch </dev/null >/dev/null 2>&1 & }
  log "запуск: $(default_text), доменов $(grep -c . "$GEO_CONF"), $(summary)"
  echo "geodns запущен; журнал: $LOG"
}
stop() {
  local p
  for p in $(watch_pid) $(ps 2>/dev/null | grep '[g]eodns watch' | awk '{ print $1 }'); do kill "$p" 2>/dev/null; done
  killall https-dns-proxy 2>/dev/null
  rm -f "$RUN/watch.pid"; rmdir "$RUN/scan.lock" 2>/dev/null
  log "остановлен"
  echo "geodns остановлен (dnsmasq продолжает работать)"
}
status() {
  local h p g
  echo "серверы обхода: $(summary)"
  while read -r h p; do echo "прокси $h (порт $p): $(proxy_alive "$p" && echo работает || echo НЕ ЗАПУЩЕН)"; done < "$RUN/ports"
  for g in $(awk '!/^#/ && NF { print $1 }' "$GROUPS" 2>/dev/null); do
    p=$(awk -v g="@$g" '$1 == g { print $2 }' "$ST/groups.pin" 2>/dev/null)
    if [ -n "$p" ] && grep -qx "$p" "$(off_eff)" 2>/dev/null; then echo "группа $g: — ($p на паузе или отключён; домены группы — по отдельности)"
    else echo "группа $g: $p"; fi
  done
  awk -F'\t' 'NF >= 4 { print "на паузе: " $1 " (прокси " $2 " отсюда не открывается)" }' "$DOWN" 2>/dev/null
  echo "dnsmasq:  $(pidof dnsmasq >/dev/null && echo работает || echo НЕ ЗАПУЩЕН)"
  echo "сторож:   $([ -n "$(watch_pid)" ] && echo работает || echo НЕ ЗАПУЩЕН)"
  echo "всё остальное: $(default_text)"
  echo "проверка: полная $(date -d "@$(scan_time "$SCAN")" '+%d.%m %H:%M' 2>/dev/null || echo —), частая $(date -d "@$(scan_time "$SCAN.hot")" '+%d.%m %H:%M' 2>/dev/null || echo —)"
  awk -F'\t' '!/^[#=+!?]/ && NF > 2 { x = "не отвечает"; if ($2 == "ok") x = "обходит " $4 " из " $5; if ($8 != "") x = x " (" $8 ")"; print "  " $1 ": " x }' "$SCAN" 2>/dev/null
  echo "--- последние записи журнала:"
  tail -n 10 "$LOG" 2>/dev/null
}
test_domain() {
  local x s
  [ -n "$1" ] || { echo "geodns test <домен>"; return 1; }
  echo "через роутер:   $(ips "$1" 127.0.0.1 | tr '\n' ' ')"
  echo "у провайдера:   $(ips "$1" "$(provider)" | tr '\n' ' ')"
  [ -n "$DEFAULT_DOH" ] && echo "DoH $DEFAULT_DOH: $(doh "$DEFAULT_DOH" "$1" | tr '\n' ' ')"
  x=$1
  while :; do
    s=$(grep "^server=/$x/" "$GEO_CONF" 2>/dev/null | head -n 1)
    [ -n "$s" ] && { echo "в списке: $x → ${s##*#} ($(awk -v p="${s##*#}" '$2 == p { print $1 }' "$RUN/ports"))"; return 0; }
    case "$x" in *.*) x=${x#*.} ;; *) break ;; esac
  done
  echo "в списке: нет — идёт к провайдеру"
}
update() {
  local n
  curl -s -f --max-time 30 "$LIST_URL" -o "$LIST.dl" || { rm -f "$LIST.dl"; echo "не скачалось — список не тронут"; return 1; }
  n=$(grep -c -E '^[a-zA-Z0-9.-]+\.[a-zA-Z0-9-]+$' "$LIST.dl")
  [ "$n" -ge 50 ] || { rm -f "$LIST.dl"; echo "скачался странный файл ($n доменов) — список не тронут"; return 1; }
  { cat "$LIST" "$LIST.dl"; } | tr -d '\r' | tr 'A-Z' 'a-z' | grep -E '^[a-z0-9.-]+\.[a-z0-9-]+$' | sort -u > "$LIST.new"
  rm -f "$LIST.dl"; mv -f "$LIST.new" "$LIST"
  build; dnsmasq_restart
  log "список обновлён: $(grep -c . "$GEO_CONF") доменов"
  echo "готово: $(grep -c . "$GEO_CONF") доменов; новые домены проверятся при полной проверке (geodns scan)"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  scan) work_lock wait; scan full && apply && proxy_check all; work_unlock; tail -n 3 "$LOG" ;;
  check) work_lock wait; scan hot && apply && proxy_check use; work_unlock; tail -n 3 "$LOG" ;;
  routes) routes ;;
  test) test_domain "$2" ;;
  update) update ;;
  build) build ;;
  apply) apply ;;
  watch) watch ;;
  doh) doh "$2" "$3" ;;
  log) cat "$LOG" ;;
  *) echo "geodns start|stop|restart|status|scan|check|routes|test <домен>|update|log" ;;
esac

#!/bin/sh

INIT_SCRIPT="/opt/etc/init.d/S55geodns"

# Set `install` or `upgrade` for postinst script
echo "$1" > "/opt/tmp/geodns_install_type"

# Stop service before upgrade (prerm of the old package stops it too — quietly here)
if [ -f "$INIT_SCRIPT" ]; then
  $INIT_SCRIPT stop >/dev/null 2>&1
fi

# Ручная установка до пакета: группы были в sites.conf, теперь — groups.list
if [ -f "/opt/etc/geodns/sites.conf" ]; then
  mv -f "/opt/etc/geodns/sites.conf" "/opt/etc/geodns/sites.conf-old"
  echo "sites.conf was moved to sites.conf-old (groups are in groups.list now)"
fi

exit 0
